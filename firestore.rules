rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);

      // User's private job applications collection
      match /applications/{applicationId} {
        allow read, write: if isValidId(userId) && isValidId(applicationId) && isOwner(userId);
      }

      // User's private chat messages
      match /messages/{messageId} {
        allow read, write: if isValidId(userId) && isValidId(messageId) && isOwner(userId);
      }
    }
  }
}
